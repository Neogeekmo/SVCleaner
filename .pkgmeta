package-as: SVCleaner
# Client TOCs are checked in: Titan currently shares the _Wrath suffix and
# BigWigs' automatic Titan TOC generation is disabled upstream.
enable-toc-creation: no
enable-nolib-creation: no

move-folders:
  SVCleaner/addon: SVCleaner

ignore:
  # Ship TOCs, runtime Lua modules, TGA UI assets, LICENSE and NOTICE.
  - companion
  - tools
  - tests
  - docs
  - artwork
  - addon/locales
  - data
  - output
  - __pycache__
  - .pytest_cache
  - .cache
  - .release
  - .github
  - .vscode
  - .gitignore
  - .pkgmeta
  - .gitattributes
  - .venv
  - .venv-packaging
  - .ruff_cache
  - .coverage
  - coverage.xml
  - htmlcov
  - pyproject.toml
  - requirements-dev.txt
  - requirements-packaging.txt
  - AGENTS.md
  - README.md
  # Development launchers and source artwork are never loaded by WoW.
  - "*.cmd"
  - "addon/Assets/*.png"
  - "addon/Assets/*.svg"
  - "*.pyc"
  - "*.code-workspace"
