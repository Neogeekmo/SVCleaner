package-as: SVCleaner
# All clients load the same modules through SVCleaner.toc. Its Interface list
# is the single source of supported builds for both local and BigWigs packages.
enable-toc-creation: no
enable-nolib-creation: no

manual-changelog:
  filename: docs/changelog.md
  markup-type: markdown

move-folders:
  SVCleaner/addon: SVCleaner

ignore:
  # Ship TOCs, runtime Lua modules, TGA UI assets, LICENSE and NOTICE.
  - companion
  - tools
  - tests
  - docs
  - artwork
  - data
  - output
  - __pycache__
  - .pytest_cache
  - .cache
  - .release
  - .github
  - .vscode
  - .gitignore
  - .pkgmeta
  - .gitattributes
  - .venv
  - .venv-packaging
  - .ruff_cache
  - .coverage
  - coverage.xml
  - htmlcov
  - pyproject.toml
  - requirements-dev.txt
  - requirements-packaging.txt
  - AGENTS.md
  - README.md
  # Development launchers and source artwork are never loaded by WoW.
  - "*.cmd"
  - "addon/Assets/*.png"
  - "addon/Assets/*.svg"
  - "*.pyc"
  - "*.code-workspace"
